{
  "name": "healthmodel-bicep-generator",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "generate": "ts-node generate.ts",
    "test": "ts-node generate.ts --test",
    "test:contracts": "npm run test:pure-layout && ts-node generator-contract.test.ts && ts-node link-discovery-root.contract.test.ts",
    "test:connectivity": "sh -c 'for f in connectivity-*.test.ts; do ts-node \"$f\" || exit 1; done'",
    "connectivity:plan": "ts-node connectivity-run.ts --mode plan",
    "connectivity:preflight": "ts-node connectivity-run.ts --mode preflight",
    "connectivity:render-bicep": "ts-node connectivity-run.ts --mode render-bicep --output ../../infra/healthmodel/connectivity-demos.bicep",
    "test:layout": "ts-node layout.test.ts",
    "test:arrange": "ts-node arrange.adapter.test.ts",
    "test:pure-layout": "npm run test:layout && npm run test:arrange",
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}
